{
  "manifest_version": 3,
  "name": "Mindrop",
  "short_name": "Mindrop",
  "version": "1.6.0",
  "description": "Mindrop : ton second cerveau visuel. Garde pages, liens, notes, citations et images, 100 % local.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Enregistrer dans Mindrop",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "activeTab",
    "scripting",
    "favicon",
    "nativeMessaging",
    "alarms"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Ouvrir la fenêtre d'enregistrement"
    },
    "quick-save": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Enregistrer la page instantanément"
    },
    "open-brain": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Ouvrir Mindrop"
    }
  }
}
